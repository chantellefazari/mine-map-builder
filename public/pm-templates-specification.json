  "dataArchitecture": {
    "databaseTable": "pm_master_list",
    "columns": {
      "id": "uuid, PK, auto-generated",
      "pm_name": "text, NOT NULL — exact match to canonical registry",
      "equipment_type": "text, NOT NULL",
      "frequency": "text, NOT NULL — values: Daily, 1 Week, 2 Week, 6 Week, 12 Week, 24 Week, 52 Week",
      "discipline": "text, NOT NULL — values: Mechanical, Electrical, Ops",
      "duty_type": "text, default 'Both' — values: Duty, Standby, Both",
      "purpose": "text",
      "estimated_duration": "text",
      "skill_level": "text",
      "required_tools": "text[]",
      "required_ppe": "text[]",
      "isolation_requirements": "text",
      "safety_notes": "text[]",
      "tasks": "jsonb — main inspection data, normalized by DynamicInspectionTable",
      "inspection_points": "jsonb",
      "acceptable_criteria": "text[]",
      "signs_of_failure": "text[]",
      "lubrication_notes": "text",
      "oem_references": "text",
      "status": "text, default 'Draft' — values: Draft, Reviewed, Approved",
      "asset_number": "text — linked asset ID from hierarchy",
      "resources": "text — e.g. '1x Fitter (2 hrs)'",
      "created_at": "timestamptz",
      "updated_at": "timestamptz"
    },
    "tasksJsonbShapes": {
      "description": "The 'tasks' JSONB column supports multiple data shapes, all normalized by DynamicInspectionTable",
      "shape1_sections": {
        "format": "{ sections: [{ equipmentName?, equipmentId?, mccId?, mccName?, tasks: [{ task, hasTemp?, tempLabel?, hasInput?, inputLabel?, hasPressure?, pressureLabel?, recommendedAmount? }], tempGuidelines? }] }",
        "usedBy": "Most mechanical plant inspections (Mill, Filter Press, Thickener, Tanks, etc.)"
      },
      "shape2_flatStringArray": {
        "format": "[\"task1\", \"task2\", ...]",
        "usedBy": "Simple inspections (RO Plant Daily, Switchboard Yearly)"
      },
      "shape3_flatObjectArray": {
        "format": "[{ task: \"...\", hasTemp?, ... }]",
        "usedBy": "Grease & Oils, Ice Machine, Crusher Generator Electrical"
      },
      "shape4_arraySections": {
        "format": "[{ sectionName, items: [{ id, description }] }]",
        "usedBy": "All mobile equipment / Ops templates (Dozer, Excavator, Moxy, Crane, etc.)"
      },
      "shape5_mccSections": {
        "format": "{ mccSections: [{ mccId, mccName }], standardTasks: [\"task1\", ...] }",
        "usedBy": "Field MCC Inspections"
      },
      "specialShapes": {
        "visualZoneChecks": "{ generalAreaChecks: [...], lightingChecks: [...], generatorChecks: [...], cleansTasks: [...] }",
        "safetyShower": "{ inspectionItems: [...], locations: [...] }",
        "substationFortnightly": "{ insideSubstationChecks: [...], outsideSubstationChecks: [...] }",
        "emergencyLightTest": "{ inspectionSteps: [...], testTableRows: number }",
        "acService": "{ serviceInfoFields: [...], testItems: [...] }",
        "pullWireChecks": "{ assetSections: [{ assetName, checks: [...] }] }",
        "rcdInjectionTest": "{ generatorLocations: [{ id, name, assetNumber, area, circuits: [{ description, rating }] }] }",
        "rcdPushButtonTest": "Same as rcdInjectionTest",
        "generatorYearlyTest": "{ deadTests, insulationTests, continuityTests, visualChecks, generatorElectricalChecks, runningTests }",
        "cableTestSheet": "{ checklistItems: [...], testColumns: [...] }",
        "fullTestSheet": "{ testColumns: [...], testRows: number }",
        "motorInspection": "{ stationaryChecks: [{ item, action }], motors: [{ description, brand, flc, frequency, power, voltage, frameSize?, rpm, ambientTemp?, equipmentNumber? }] }",
        "rcdTestingSheets": "{ generatorId, generatorName, assetNumber, area, testType: 'push-button'|'injection', frequency: '3M'|'6M', circuits: [{ description, rating }] }"
      }
    },
    "renderingComponent": {
      "name": "DynamicInspectionTable",
      "props": {
        "tasksData": "any — the raw JSONB from pm_master_list.tasks",
        "title": "string, default 'INSPECTIONS'",
        "showEquipmentId": "boolean, default false"
      },
      "normalization": "Automatically detects shape and renders consistent 4-column table"
    }
  },

