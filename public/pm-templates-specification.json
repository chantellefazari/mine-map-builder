  "persistenceRules": {
    "writeFlow": [
      "1. User edits field in UI",
      "2. Debounce (800ms for resources) or immediate (asset selection)",
      "3. supabase.from('pm_master_list').update({ field: value }).eq('id', pmId)",
      "4. Re-fetch single row to verify: supabase.from('pm_master_list').select('id, updated_at').eq('id', pmId).single()",
      "5. Log proof: [PM-SAVE] ✓ Persisted field | id=... | updated_at=...",
      "6. queryClient.invalidateQueries({ queryKey: ['pm-master-list'] })"
    ],
    "focusProtection": "isFocusedRef prevents external query invalidation from overwriting user's active typing",
    "flushOnUnmount": "useEffect cleanup calls flushResourceSave() to persist any pending debounced edits"
  },

